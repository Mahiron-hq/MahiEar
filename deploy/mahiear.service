[Unit]
Description=MahiEar
After=network-online.target
Wants=network-online.target
Requires=mahiear.socket
After=mahiear.socket
StartLimitIntervalSec=0

[Service]
Type=simple
User=mahiear
Group=mahiear
EnvironmentFile=/etc/mahiear/mahiear.env
StateDirectory=mahiear
StateDirectoryMode=0700
WorkingDirectory=/var/lib/mahiear
ExecStart=/opt/mahiear/current/mahiear-server
Restart=always
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/mahiear -/var/backups/mahiear
ReadOnlyPaths=-/srv/mahiear/library /opt/mahiear
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
MemoryMax=1G
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
